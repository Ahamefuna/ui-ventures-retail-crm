# Django Core Configuration
SECRET_KEY=replace-with-a-strong-random-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Engine Toggle
# Set USE_MYSQL=False for zero-setup local SQLite (db.sqlite3)
# Set USE_MYSQL=True to connect to MySQL 8.0
USE_MYSQL=False

# MySQL 8.0 Primary Configuration (used when USE_MYSQL=True)
DB_NAME=uiventures_crm
DB_USER=uiventures_user
DB_PASSWORD=change_me_secure_password
DB_HOST=127.0.0.1
DB_PORT=3306
